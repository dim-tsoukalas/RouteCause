# Optional — the tool runs fully offline (no-LLM mode) without any of this.
# Set a model to enable natural-language narration over the same cited sources.

# Any LiteLLM model string works:
#   INVESTIGATOR_MODEL=gpt-4o-mini
#   INVESTIGATOR_MODEL=claude-3-5-sonnet-latest
#   INVESTIGATOR_MODEL=ollama/llama3.1
INVESTIGATOR_MODEL=

# Provider key for whichever model you chose (only one needed):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
